{
  "name": "@deepseek-ai/dsh-harness-jsonrpc-server",
  "description": "Stdio JSON-RPC plugin exposing DeepSeek Harness runtime capabilities (get_context, get_capabilities, create_scope, policy_check) to external consumers",
  "version": "0.2.0-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/sdk/harness-jsonrpc-server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-sdk-protocol": "workspace:*",
    "@deepseek-ai/dsh-scope": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-sdk-protocol": "workspace:*",
    "@deepseek-ai/dsh-scope": "workspace:*"
  }
}
